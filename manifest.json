{
  "manifest_version": 3,
  "name": "Layout Grid Visualizer",
  "version": "1.2.2",
  "description": "A Chrome extension to visualize and customize grid layouts on webpages",
  "minimum_chrome_version": "100",
  "author": "Abu Foysal",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-grid": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Toggle grid overlay"
    }
  }
}
